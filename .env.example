# 이 프로젝트는 .env 파일을 자동으로 읽지 않는다.
# 아래 값을 실제 환경변수로 export 하거나, IDE 실행 설정(Run Configuration)의
# Environment Variables에 넣고 실행할 것.

# Supabase Project Settings > Database > Connection string 참고.
# 주의: db.<project-ref>.supabase.co (Direct connection)는 IPv6 전용이라
# IPv6이 안 되는 네트워크에서는 접속이 안 된다. 그 경우 같은 페이지의
# "Connection pooling" 섹션에 있는 Session pooler 주소(aws-0-...pooler.supabase.com)를 써라.
DB_URL=jdbc:postgresql://db.wfovlprcxmsanfuzbfvd.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# Supabase Project Settings > API > JWT Settings 에서 확인.
SUPABASE_JWT_ISSUER_URI=https://wfovlprcxmsanfuzbfvd.supabase.co/auth/v1
