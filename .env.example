# 이 프로젝트는 .env 파일을 자동으로 읽지 않는다.
# 아래 값을 실제 환경변수로 export 하거나, IDE 실행 설정(Run Configuration)의
# Environment Variables에 넣고 실행할 것.

# Supabase Project Settings > Database > Connect > Session pooler 참고.
# db.<project-ref>.supabase.co (Direct connection)는 IPv6 전용이라 대부분의 사내망/AWS
# 기본 VPC에서 못 붙는다 (직접 확인함). Session pooler는 같은 걸 IPv4로 프록시해준다.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.wfovlprcxmsanfuzbfvd
DB_PASSWORD=

# Supabase Project Settings > API > JWT Settings 에서 확인.
SUPABASE_JWT_ISSUER_URI=https://wfovlprcxmsanfuzbfvd.supabase.co/auth/v1
