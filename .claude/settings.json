{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
